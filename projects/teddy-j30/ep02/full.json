  "lines": [
    {
      "id": "L0",
      "text": "Hier, vous avez choisi : la douche.",
      "pause": 1.0,
      "colors": {
        "LA DOUCHE": "violet",
        "DOUCHE": "violet"
      }
    },
    {
      "id": "L1",
      "text": "Problème : Teddy n'a pas pris de vraie douche depuis mardi.",
      "pause": 0.3,
      "colors": {
        "PROBLÈME": "red",
        "MARDI": "red"
      }
    },
    {
      "id": "L2",
      "text": "Et on est samedi.",
      "pause": 0.6,
      "colors": {
        "SAMEDI": "red"
      }
    },
    {
      "id": "L3",
      "text": "Il ouvre la porte de la salle de bain.",
      "pause": 0.5,
      "colors": {
        "SALLE DE BAIN": "cyan"
      }
    },
    {
      "id": "L4",
      "text": "Sa douche lui sert de placard.",
      "pause": 0.3,
      "colors": {
        "PLACARD": "orange"
      }
    },
    {
      "id": "L5",
      "text": "Des chips, trois cartons de pizza, et une plante qui a poussé toute seule.",
      "pause": 0.5,
      "replace": {
        "TROIS CARTONS": "3 CARTONS"
      },
      "colors": {
        "CHIPS": "gold",
        "3 CARTONS": "gold",
        "TOUTE SEULE": "gold"
      }
    },
    {
      "id": "L6",
      "who": "teddy",
      "text": "Tranquille.",
      "pause": 0.5
    },
    {
      "id": "L7",
      "text": "Il tourne le robinet.",
      "pause": 0.35,
      "colors": {
        "ROBINET": "cyan"
      }
    },
    {
      "id": "L8",
      "text": "L'eau est glacée.",
      "pause": 0.15,
      "colors": {
        "GLACÉE": "cyan"
      }
    },
    {
      "id": "L9",
      "who": "teddy",
      "text": "Aaaaah !",
      "pause": 0.4,
      "colors": {
        "AAAAAH": "red"
      }
    },
    {
      "id": "L10",
      "text": "Sa mèche gèle sur place.",
      "pause": 0.5,
      "colors": {
        "GÈLE": "cyan"
      }
    },
    {
      "id": "L11",
      "text": "Il attrape le premier flacon qu'il trouve.",
      "pause": 0.3,
      "colors": {
        "FLACON": "gold"
      }
    },
    {
      "id": "L12",
      "text": "Pas de chance : c'est du liquide vaisselle.",
      "pause": 0.4,
      "colors": {
        "LIQUIDE VAISSELLE": "red",
        "VAISSELLE": "red"
      }
    },
    {
      "id": "L13",
      "text": "La mousse envahit la salle de bain…",
      "pause": 0.2,
      "colors": {
        "MOUSSE": "cyan",
        "SALLE DE BAIN": "cyan"
      }
    },
    {
      "id": "L14",
      "text": "puis le couloir.",
      "pause": 0.5,
      "colors": {
        "COULOIR": "red"
      }
    },
    {
      "id": "L15",
      "text": "Pendant ce temps, Bzz fait ses valises.",
      "pause": 0.6,
      "colors": {
        "BZZ": "gold",
        "VALISES": "orange"
      }
    },
    {
      "id": "L16",
      "text": "Vingt minutes plus tard…",
      "pause": 0.5,
      "replace": {
        "VINGT MINUTES": "20 MINUTES"
      },
      "colors": {
        "20 MINUTES": "gold"
      }
    },
    {
      "id": "L17",
      "text": "Teddy sort. Propre. Pour la première fois depuis une semaine.",
      "pause": 0.4,
      "colors": {
        "PROPRE": "gold",
        "PREMIÈRE FOIS": "gold",
        "SEMAINE": "gold"
      }
    },
    {
      "id": "L18",
      "text": "Croquette revient. Elle renifle… et elle applaudit.",
      "pause": 0.5,
      "colors": {
        "CROQUETTE": "orange",
        "APPLAUDIT": "gold"
      }
    },
    {
      "id": "L19",
      "text": "Glow-up : plus quatre pour cent.",
      "pause": 0.4,
      "replace": {
        "PLUS QUATRE POUR CENT": "+4 %"
      },
      "colors": {
        "+4 %": "gold"
      }
    },
    {
      "id": "L20",
      "text": "Mais il a remis… le même sweat.",
      "pause": 0.3,
      "colors": {
        "MÊME SWEAT": "red"
      }
    },
    {
      "id": "L21",
      "text": "Moins un.",
      "pause": 0.5,
      "replace": {
        "MOINS UN": "−1 %"
      },
      "colors": {
        "−1 %": "red"
      }
    },
    {
      "id": "L22",
      "text": "Et là, Inès écrit : au fait, tu viens avec qui ?",
      "pause": 0.5,
      "colors": {
        "INÈS": "pink",
        "AVEC QUI": "pink",
        "QUI": "pink"
      }
    },
    {
      "id": "L23",
      "who": "teddy",
      "text": "Tranquille…",
      "pause": 0.5
    },
    {
      "id": "L24",
      "text": "Demain, c'est encore vous qui choisissez.",
      "pause": 0.3,
      "colors": {
        "VOUS": "gold",
        "CHOISISSEZ": "gold"
      }
    },
    {
      "id": "L25",
      "text": "Dents, ou draps ? Un seul mot en commentaire.",
      "pause": 0.3,
      "colors": {
        "DENTS": "violet",
        "DRAPS": "orange",
        "UN SEUL MOT": "gold",
        "COMMENTAIRE": "gold"
      }
    },
    {
      "id": "L26",
      "text": "Le jour vingt-huit commence avec votre choix.",
      "pause": 1.2,
      "replace": {
        "VINGT-HUIT": "28"
      },
      "colors": {
        "28": "gold",
        "VOTRE CHOIX": "gold"
      }
    }
