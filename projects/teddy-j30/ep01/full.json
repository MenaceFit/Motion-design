{
  "slug": "teddy-ep01",
  "fps": 60,
  "music": {
    "mood": "hype",
    "bpm": 125,
    "seed": 30
  },
  "voice": {
    "engine": "pico",
    "speed": 1.06,
    "pitch": -120
  },
  "drop_cue": "L1end",
  "lines": [
    {
      "id": "L0",
      "text": "Dans trente jours, son ex se marie.",
      "pause": 0.35,
      "replace": {
        "TRENTE JOURS": "30 JOURS"
      },
      "colors": {
        "EX": "pink",
        "SE MARIE": "pink",
        "30 JOURS": "gold"
      },
      "tts_text": "[mysterious] Dans trente jours… son ex se marie."
    },
    {
      "id": "L1",
      "text": "Et elle l'a invité.",
      "pause": 1.15,
      "colors": {
        "L'A INVITÉ": "pink"
      },
      "tts_text": "[dramatic pause] Et elle l'a invité."
    },
    {
      "id": "L2",
      "text": "Voici Teddy. Vingt-quatre ans.",
      "pause": 0.3,
      "replace": {
        "VINGT-QUATRE ANS": "24 ANS"
      },
      "colors": {
        "TEDDY": "gold"
      },
      "tts_text": "[amused] Voici Teddy. Vingt-quatre ans."
    },
    {
      "id": "L3",
      "text": "Rang Diamant à son jeu…",
      "pause": 0.2,
      "colors": {
        "DIAMANT": "cyan"
      },
      "tts_text": "[proud] Rang Diamant à son jeu…"
    },
    {
      "id": "L4",
      "text": "et rang carton dans la vraie vie.",
      "pause": 0.45,
      "colors": {
        "CARTON": "red",
        "VRAIE VIE": "red"
      },
      "tts_text": "[deadpan] et rang carton dans la vraie vie."
    },
    {
      "id": "L5",
      "text": "Son sweat n'a pas été lavé depuis onze jours.",
      "pause": 0.3,
      "replace": {
        "ONZE JOURS": "11 JOURS"
      },
      "colors": {
        "LAVÉ": "red",
        "11 JOURS": "red"
      },
      "tts_text": "[disgusted] Son sweat n'a pas été lavé depuis… onze jours."
    },
    {
      "id": "L6",
      "text": "Celui de rechange tient debout tout seul.",
      "pause": 0.5,
      "colors": {
        "TOUT SEUL": "gold",
        "DEBOUT": "gold"
      },
      "tts_text": "[incredulous] Celui de rechange tient debout tout seul."
    },
    {
      "id": "L7",
      "text": "Même les mouches portent un masque.",
      "pause": 0.5,
      "colors": {
        "MOUCHES": "cyan",
        "MASQUE": "cyan"
      },
      "tts_text": "[whispers] Même les mouches portent un masque."
    },
    {
      "id": "L8",
      "text": "Et son chat a fait ses valises.",
      "pause": 0.6,
      "colors": {
        "CHAT": "orange",
        "VALISES": "orange"
      },
      "tts_text": "[sad] Et son chat a fait ses valises."
    },
    {
      "id": "L9",
      "text": "Tranquille.",
      "pause": 0.55,
      "tts_text": "[confident] Tranquille.",
      "who": "teddy"
    },
    {
      "id": "L10",
      "text": "Ce soir, Inès lui écrit.",
      "pause": 0.35,
      "colors": {
        "INÈS": "pink"
      },
      "tts_text": "[teasing] Ce soir, Inès lui écrit."
    },
    {
      "id": "L11",
      "text": "Il tape. Il efface. Il retape.",
      "pause": 1.4,
      "colors": {
        "EFFACE": "red",
        "RETAPE": "gold"
      },
      "tts_text": "[fast] Il tape. Il efface. [sighs] Il retape."
    },
    {
      "id": "L12",
      "text": "Et il envoie… un pouce.",
      "pause": 0.55,
      "colors": {
        "UN POUCE": "gold",
        "POUCE": "gold"
      },
      "tts_text": "[suspenseful] Et il envoie… [laughs] un pouce."
    },
    {
      "id": "L13",
      "text": "Vu.",
      "pause": 0.9,
      "colors": {
        "VU": "red"
      },
      "tts_text": "[flatly] Vu."
    },
    {
      "id": "L14",
      "text": "Le futur marié ? Maxence.",
      "pause": 0.25,
      "colors": {
        "MAXENCE": "cyan"
      },
      "tts_text": "[impressed] Le futur marié ? Maxence."
    },
    {
      "id": "L15",
      "text": "Il court dix kilomètres avant le petit-déj.",
      "pause": 0.3,
      "replace": {
        "DIX KILOMÈTRES": "10 KM"
      },
      "colors": {
        "10 KM": "cyan"
      },
      "tts_text": "[admiring] Il court dix kilomètres avant le petit-déj."
    },
    {
      "id": "L16",
      "text": "Teddy, lui, court seulement quand le livreur se trompe d'étage.",
      "pause": 0.9,
      "colors": {
        "TEDDY": "gold",
        "LIVREUR": "orange",
        "D'ÉTAGE": "orange"
      },
      "tts_text": "[sarcastic] Teddy, lui, court seulement quand le livreur se trompe d'étage."
    },
    {
      "id": "L17",
      "text": "Et là, Mamie Jo envoie un vocal.",
      "pause": 0.3,
      "colors": {
        "MAMIE JO": "violet",
        "VOCAL": "violet"
      },
      "tts_text": "[excited] Et là, Mamie Jo envoie un vocal."
    },
    {
      "id": "L18",
      "text": "Trente jours, mon chéri. Moi, en trente jours, j'ai appris l'allemand et la boxe. Bouge-toi !",
      "pause": 0.45,
      "replace": {
        "TRENTE JOURS": "30 JOURS"
      },
      "colors": {
        "30 JOURS": "gold",
        "L'ALLEMAND": "violet",
        "LA BOXE": "red",
        "BOUGE-TOI": "red"
      },
      "tts_text": "[energetic] Trente jours, mon chéri ! Moi, en trente jours, j'ai appris l'allemand ET la boxe. [shouts] Bouge-toi !",
      "who": "mamie"
    },
    {
      "id": "L19",
      "text": "Tranquille.",
      "pause": 0.5,
      "tts_text": "[unbothered] Tranquille.",
      "who": "teddy"
    },
    {
      "id": "L20",
      "text": "Problème : il ne sait pas par où commencer.",
      "pause": 0.3,
      "colors": {
        "PROBLÈME": "red",
        "COMMENCER": "gold"
      },
      "tts_text": "[worried] Problème : il ne sait pas par où commencer."
    },
    {
      "id": "L21",
      "text": "Alors c'est vous qui décidez.",
      "pause": 0.35,
      "colors": {
        "VOUS": "gold",
        "DÉCIDEZ": "gold"
      },
      "tts_text": "[conspiratorial] Alors… c'est vous qui décidez."
    },
    {
      "id": "L22",
      "text": "Douche, ou chambre ? Écris un seul mot en commentaire.",
      "pause": 0.3,
      "colors": {
        "DOUCHE": "violet",
        "CHAMBRE": "orange",
        "UN SEUL MOT": "gold",
        "COMMENTAIRE": "gold"
      },
      "tts_text": "[excited] Douche, ou chambre ? Écris un seul mot en commentaire !"
    },
    {
      "id": "L23",
      "text": "Le jour vingt-neuf commence avec votre choix.",
      "pause": 1.2,
      "replace": {
        "VINGT-NEUF": "29"
      },
      "colors": {
        "29": "gold",
        "VOTRE CHOIX": "gold"
      },
      "tts_text": "[dramatic] Le jour vingt-neuf commence… avec votre choix."
    }
  ],
